aws_region              = "ap-northeast-2"
project_name            = "learn-hub"
environment             = "prod"

instance_type           = "t3.micro"

# Optional: keep empty to use SSM only.
# key_name              = "your-keypair-name"

# Optional: open SSH only from your IP if you really need it.
# allowed_ssh_cidrs     = ["1.2.3.4/32"]

container_image         = "leegeonho/learn-hub-backend:0.1.6"
mysql_image             = "mysql:8.4"
java_opts               = "-Xms256m -Xmx512m"

db_password             = "change-me"
jwt_secret_key          = "change-me"
kakao_client_id         = "your-kakao-client-id"
kakao_client_secret     = "your-kakao-client-secret"
kakao_redirect_uri      = "https://learn-hub.kr/kakao/callback"
gemini_api_key          = "your-gemini-api-key"
gemini_model_name       = "gemini-2.5-flash"
